// Function objects for the cascade runs (included by controlDict)

bladeSurface                        // blade static pressure, face values in patch order
{
    type            surfaces;
    libs            (sampling);
    writeControl    writeTime;
    surfaceFormat   raw;
    fields          (p);
    interpolationScheme cell;
    surfaces
    {
        blade
        {
            type        patch;
            patches     (row_1_BLADE);
            interpolate false;
        }
    }
}

bladeForce                          // convergence monitor
{
    type            forces;
    libs            (forces);
    writeControl    timeStep;
    writeInterval   1;
    patches         (row_1_BLADE);
    rho             rho;
    CofR            (0 0 0);
    log             false;
}

inletState                          // inlet velocity (input to the constant-total-pressure wake cases)
{
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);
    writeControl    writeTime;
    log             false;
    writeFields     false;
    regionType      patch;
    name            row_1_INFLOW;
    operation       areaAverage;
    fields          (U p T);
}

// mass-weighted inlet and outlet states and mass flow: total-pressure loss coefficient for the
// mesh study and the snappyHexMesh / AutoGrid5 comparison (cascade_post.py)
inletMass
{
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);
    writeControl    writeTime;
    log             false;
    writeFields     false;
    regionType      patch;
    name            row_1_INFLOW;
    operation       weightedAverage;
    weightField     phi;
    fields          (U p T);
}
outletMass
{
    $inletMass;
    name            row_1_OUTFLOW;
}
massFlow
{
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);
    writeControl    writeTime;
    log             false;
    writeFields     false;
    regionType      patch;
    name            row_1_INFLOW;
    operation       sum;
    fields          (phi);
}

yPlus
{
    type            yPlus;
    libs            (fieldFunctionObjects);
    executeControl  writeTime;          // only when fields are written: computed every iteration, its square
                                        // root was the first thing to fail on a transient bad wall value (5 Nov)
    writeControl    writeTime;
    log             false;
}

residuals
{
    type            solverInfo;
    libs            (utilityFunctionObjects);
    fields          (U p e nuTilda);
    writeResidualFields no;
}

