/*--------------------------------*- C++ -*----------------------------------*\
|  MEng rerun - Chapter 2 cascade verification - OpenFOAM v2606               |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p.PIBC;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/caseParameters"

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform $pOutlet;

boundaryField
{
    // constraint patches by group (AutoGrid5: cyclic and empty; snappyHexMesh: cyclicAMI and empty).
    // Not #includeEtc "caseDicts/setConstraintTypes": in v2606 it gives cyclicAMI "value $internalField",
    // which fails once init_from_inc.py has copied in a non-uniform internal field (3 Nov).
    cyclic      { type cyclic; }
    cyclicAMI   { type cyclicAMI; }
    empty       { type empty; }

    row_1_INFLOW
    {
        type            totalPressure;                  // isentropic compressible form
        p0              uniform $p0Inlet;
        gamma           1.4;
        psi             thermo:psi;
        rho             none;
        value           uniform $pOutlet;
    }
    row_1_OUTFLOW
    {
        type            fixedMean;
        meanValue       constant $pOutlet;
        value           uniform $pOutlet;
    }
    row_1_BLADE
    {
        type            zeroGradient;
    }
}

// ************************************************************************* //
