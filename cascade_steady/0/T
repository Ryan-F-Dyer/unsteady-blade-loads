/*--------------------------------*- C++ -*----------------------------------*\
|  MEng rerun - Chapter 2 cascade verification - OpenFOAM v2606               |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/caseParameters"

dimensions      [0 0 0 1 0 0 0];

internalField   uniform $Tinlet;

boundaryField
{
    // constraint patches by group (AutoGrid5: cyclic and empty; snappyHexMesh: cyclicAMI and empty).
    // Not #includeEtc "caseDicts/setConstraintTypes": in v2606 it gives cyclicAMI "value $internalField",
    // which fails once init_from_inc.py has copied in a non-uniform internal field (3 Nov).
    cyclic      { type cyclic; }
    cyclicAMI   { type cyclicAMI; }
    empty       { type empty; }

    row_1_INFLOW
    {
        type            totalTemperature;
        T0              uniform $T0Inlet;
        gamma           1.4;
        psi             thermo:psi;
        value           uniform $Tinlet;
    }
    row_1_OUTFLOW
    {
        type            zeroGradient;
    }
    row_1_BLADE
    {
        type            fixedValue;                     // isothermal wall at 296 K, as the v1712 runs and the experiment
        value           uniform $Twall;
    }
}

// ************************************************************************* //
